<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Libretro.Core</AssemblyName>
    <RootNamespace>Libretro.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsPackable>true</IsPackable>
    <Version>$(CoreKitManagedPackageVersion)</Version>
    <PackageId>Libretro.Core</PackageId>
    <Title>Libretro.Core</Title>
    <Authors>Sean Burkes</Authors>
    <Description>Reusable, strongly typed .NET hosting primitives for NativeAOT libretro cores.</Description>
    <Copyright>Copyright (c) 2026 Sean Burkes</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/seanburkes/Libretro.CoreKit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/seanburkes/Libretro.CoreKit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>libretro;retroarch;emulation;nativeaot</PackageTags>
    <PackageReleaseNotes>Adds Linux native logging companion sources and package-backed NativeAOT validation.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <None Update="PACKAGE.md" Pack="true" PackagePath="README.md" />
    <None Update="Native/libretro_log_shim.c"
          Pack="true"
          PackagePath="native/libretro_log_shim.c" />
    <None Include="../../eng/libretro/libretro.h"
          Pack="true"
          PackagePath="native/libretro.h" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers"
                      Version="5.6.0"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
